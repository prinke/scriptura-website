---
/** A Discord message button, for use in mock bot replies. */
interface Props {
	style?: 'secondary' | 'success' | 'danger' | 'primary';
	disabled?: boolean;
	class?: string;
}

const { style = 'secondary', disabled = false, class: className } = Astro.props;

const bg = {
	secondary: 'bg-dc-btn-secondary',
	success: 'bg-dc-btn-success',
	danger: 'bg-dc-btn-danger',
	primary: 'bg-dc-blurple',
}[style];
---

<span
	class:list={[
		'inline-flex h-8 min-w-[60px] items-center justify-center gap-1.5 rounded-[3px] px-4 text-sm font-medium text-white select-none',
		bg,
		disabled && 'opacity-50',
		className,
	]}
><slot /></span>
